{
  "openapi": "3.1.0",
  "info": { "title": "Acme Checkout API", "version": "1.5.0" },
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/users": {
      "get": {
        "summary": "List users",
        "parameters": [
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer" } },
          { "name": "role", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": {}, "401": {} }
      },
      "post": {
        "summary": "Create user",
        "requestBody": { "content": { "application/json": {} } },
        "responses": { "201": {}, "400": {} }
      }
    },
    "/orders/{id}/refund": {
      "post": {
        "summary": "Refund an order",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "202": {}, "404": {} }
      }
    }
  }
}
